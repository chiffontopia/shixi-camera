# 本机私密配置示例 —— 复制成 tools/ai_secret.conf 后填真值
# tools/ai_secret.conf 已在 .gitignore 里，不会被提交；请勿把真密钥写进示例文件。

# === tools/ai_relay.py 用（板子能连到本机时）===
endpoint=https://api.example.com/v1/chat/completions
api_key=REPLACE_WITH_YOUR_API_KEY
# 板子侧 relay_key 文件里写同样的口令（板子只持有这个本地口令，不持有云端密钥）
relay_key=REPLACE_WITH_A_LOCAL_PASSPHRASE
# 可选：强制模型名（覆盖板子传来的 model）
# model=deepseek/deepseek-v4.1-flash
port=3688

# === tools/ai_bridge.sh 用（板子连不到本机时）===
# 同一份文件里 endpoint / api_key 就够了；桥接脚本读的是上面两行。
